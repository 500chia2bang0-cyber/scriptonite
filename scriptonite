--============ AUTO FARM ============
local farmQueue = {}
local farmQueueBuilt = 0

local function farmRank(name)
	local lower = string.lower(name)
	for i = 1, #state.priorityList do
		if string.find(lower, string.lower(state.priorityList[i]), 1, true) then
			return i
		end
	end
	return nil
end

local function buildFarmQueue()
	farmQueue = {}
	farmQueueBuilt = os.clock()
	local root = getRoot()
	if not root then return end
	local rp = root.Position
	local container = workspace:FindFirstChild("chests") or workspace
	for _, d in ipairs(container:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local parent = d.Parent
			if parent then
				local pname = (parent.Name or "") .. " " .. (d.ObjectText or "")
				local rank = farmRank(pname)
				if rank then
					local part = getPart(parent)
					if part then
						local d2 = (part.Position - rp).Magnitude
						farmQueue[#farmQueue + 1] = {
							prompt = d, part = part, pos = part.Position,
							rank = rank, dist2 = d2 * d2,
						}
					end
				end
			end
		end
	end
	table.sort(farmQueue, function(a, b)
		if a.rank ~= b.rank then return a.rank < b.rank end
		return a.dist2 < b.dist2
	end)
end

local function doFarmStep()
	if #farmQueue == 0 or (os.clock() - farmQueueBuilt) > 3 then
		buildFarmQueue()
		if #farmQueue == 0 then return end
	end
	local target = table.remove(farmQueue, 1)
	if not target then return end
	if not target.prompt or not target.prompt.Parent then return end
	if not target.part or not target.part.Parent then return end
	local root = getRoot()
	if not root then return end
	pcall(function() root.CFrame = CFrame.new(target.pos + Vector3.new(0, 3, 0)) end)
	pcall(function()
		if fireproximityprompt then
			fireproximityprompt(target.prompt)
		else
			target.prompt:InputHoldBegin()
			target.prompt:InputHoldEnd()
		end
	end)
end

RunService.Heartbeat:Connect(function(dt)
	if not state.autoFarm then
		state.farmAccum = 0
		return
	end
	local totalDelay = math.max(0.001, state.tpDelay + state.collectDelay)
	state.farmAccum += dt
	local steps = 0
	while state.farmAccum >= totalDelay and steps < 5 do
		state.farmAccum -= totalDelay
		doFarmStep()
		steps += 1
	end
end)

--============ AUTO OPEN ============
local function openRank(name)
	local lower = string.lower(name)
	for i = 1, #state.openList do
		if string.find(lower, string.lower(state.openList[i]), 1, true) then
			return i
		end
	end
	return nil
end
local function autoOpenLoop()
	while state.autoOpen do
		local char = getChar()
		local bp = LocalPlayer:FindFirstChild("Backpack")
		if char and bp then
			local tools = {}
			for _, t in ipairs(bp:GetChildren()) do
				if t:IsA("Tool") then
					local r = openRank(t.Name)
					if r then table.insert(tools, { tool = t, rank = r }) end
				end
			end
			table.sort(tools, function(a, b) return a.rank < b.rank end)
			for _, entry in ipairs(tools) do
				if not state.autoOpen then break end
				pcall(function()
					entry.tool.Parent = char
					task.wait(0.03)
					entry.tool:Activate()
					task.wait(state.openDelay)
					if entry.tool.Parent == char then entry.tool.Parent = bp end
				end)
			end
		end
		task.wait(0.2)
	end
end

--============ AUTO DELETE ============
local function autoDeleteLoop()
	while state.autoDelete do
		local perTick = math.max(1, math.floor(state.deleteRate / 20))
		local deleted = 0
		local char = getChar()
		local bp = LocalPlayer:FindFirstChild("Backpack")
		local function sweep(container)
			if not container then return end
			for _, tool in ipairs(container:GetChildren()) do
				if deleted >= perTick then return end
				if tool:IsA("Tool") then
					for _, name in ipairs(state.deleteList) do
						if tool.Name == name then
							pcall(function() tool.Parent = DeleteFolder end)
							deleted += 1
							break
						end
					end
				end
			end
		end
		if bp then sweep(bp) end
		if char then sweep(char) end
		task.wait(0.05)
	end
end

