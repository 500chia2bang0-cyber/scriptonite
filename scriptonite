--============ ITEM CACHE (ESP only) ============
local itemCache = { items = {}, nextRefresh = 0 }
local function refreshItems()
	local now = os.clock()
	if now < itemCache.nextRefresh then return end
	itemCache.nextRefresh = now + 0.5
	itemCache.items = {}
	for _, inst in pairs(workspace:GetDescendants()) do
		if inst:IsA("ProximityPrompt") then
			local parent = inst.Parent
			if parent and matchesKeyword(((parent.Name or "") .. " " .. (inst.ObjectText or ""))) then
				local part = getPart(parent)
				if part then
					itemCache.items[#itemCache.items + 1] = {
						kind = "prompt", inst = inst, part = part,
						name = ((parent.Name or "") .. " " .. (inst.ObjectText or "")),
					}
				end
			end
		elseif inst:IsA("ClickDetector") then
			local parent = inst.Parent
			if parent and matchesKeyword(parent.Name) then
				local part = getPart(parent)
				if part then
					itemCache.items[#itemCache.items + 1] = {
						kind = "click", inst = inst, part = part, name = parent.Name,
					}
				end
			end
		elseif inst:IsA("BasePart") and matchesKeyword(inst.Name) then
			itemCache.items[#itemCache.items + 1] = {
				kind = "touch", inst = inst, part = inst, name = inst.Name,
			}
		end
	end
end

--============ KILL AURA (TMI primitive) ============
local remoteCache = {}
local lastRemoteScan = 0
local function scanRemotes()
	local now = os.clock()
	if now - lastRemoteScan < 5 then return end
	lastRemoteScan = now
	remoteCache = {}
	for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
		if v:IsA("RemoteEvent") then table.insert(remoteCache, v) end
	end
end

local function runKillAura()
	local myChar = getChar()
	if not myChar then return end
	local myHRP = myChar:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end
	local myPos = myHRP.Position

	if state.killAuraNPC then
		local r = state.auraRangeNPC
		local r2 = r * r
		for model in pairs(npcCache) do
			if model.Parent then
				local hum = model:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					local root = model:FindFirstChild("HumanoidRootPart")
						or model:FindFirstChild("UpperTorso")
						or model:FindFirstChild("Torso")
					if root then
						local d = root.Position - myPos
						if d.Magnitude * d.Magnitude <= r2 then
							pcall(function()
								hum.Health = 0
								hum:TakeDamage(9e9)
							end)
						end
					end
				end
			else
				npcCache[model] = nil
			end
		end
	end

	if state.killAuraPlayer then
		scanRemotes()
		local r = state.auraRangePlayer
		local r2 = r * r
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					local d = hrp.Position - myPos
					if d.Magnitude * d.Magnitude <= r2 then
						for i = 1, #remoteCache do
							local r2r = remoteCache[i]
							pcall(function() r2r:FireServer(plr.Character) end)
							pcall(function() r2r:FireServer(hum, math.huge) end)
							pcall(function() r2r:FireServer("Damage", hum, 9999) end)
						end
					end
				end
			end
		end
	end
end

task.spawn(function()
	while true do
		local ok, interval = pcall(function() return state.auraInterval end)
		local wait_time = (ok and interval) or 0.2
		task.wait(wait_time)
		if state.killAuraNPC or state.killAuraPlayer then
			pcall(runKillAura)
		end
	end
end)

--============ DISGUISED AURA ============
local discAccum = 0
local savedReach = nil
local function disguisedTick()
	local char = getChar()
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		local bp = LocalPlayer:FindFirstChild("Backpack")
		if bp then
			for _, t in ipairs(bp:GetChildren()) do
				if t:IsA("Tool") then pcall(function() t.Parent = char end); break end
			end
		end
		tool = char:FindFirstChildOfClass("Tool")
	end
	if not tool then return end
	local blade = tool:FindFirstChild("Blade") or tool:FindFirstChild("Handle")
	if blade and blade:IsA("BasePart") then
		if not savedReach then savedReach = { size = blade.Size } end
		blade.Size = Vector3.new(state.disguiseRange, state.disguiseRange, state.disguiseRange)
		blade.CanTouch = true
	end
	pcall(function() tool:Activate() end)
	local root = getRoot()
	if not root then return end
	local rp = root.Position
	for model in pairs(npcCache) do
		if model.Parent then
			local hum = model:FindFirstChildOfClass("Humanoid")
			local hrp = model:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and hrp then
				if (hrp.Position - rp).Magnitude <= state.disguiseRange then
					pcall(function()
						firetouchinterest(root, hrp, 0)
						firetouchinterest(root, hrp, 1)
					end)
				end
			end
		end
	end
end
local function restoreDisguise()
	if savedReach then
		local char = getChar()
		local tool = char and char:FindFirstChildOfClass("Tool")
		local blade = tool and (tool:FindFirstChild("Blade") or tool:FindFirstChild("Handle"))
		if blade and blade:IsA("BasePart") then blade.Size = savedReach.size end
		savedReach = nil
	end
end
RunService.Heartbeat:Connect(function(dt)
	if not state.disguisedAura then
		if savedReach then restoreDisguise() end
		return
	end
	discAccum += dt
	if discAccum < state.spamRate then return end
	discAccum = 0
	disguisedTick()
end)
--============ NPC FREEZE ============
local frozen = setmetatable({}, { __mode = "k" })
local function freezeTick()
	if not state.npcFreeze then return end
	local root = getRoot()
	if not root then return end
	local rp = root.Position
	for model in pairs(npcCache) do
		if model.Parent then
			local hum = model:FindFirstChildOfClass("Humanoid")
			local hrp = model:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and hrp then
				if (hrp.Position - rp).Magnitude <= state.freezeRange then
					if not frozen[hum] then
						frozen[hum] = { ws = hum.WalkSpeed }
						pcall(function() hum.WalkSpeed = 0 end)
						pcall(function()
							local att = hrp:FindFirstChildOfClass("Attachment")
							if not att then att = Instance.new("Attachment"); att.Parent = hrp end
							local apos = Instance.new("AlignPosition")
							apos.Mode = Enum.PositionAlignmentMode.OneAttachment
							apos.Attachment0 = att
							apos.Position = hrp.Position
							apos.MaxForce = math.huge
							apos.Parent = hrp
							local aori = Instance.new("AlignOrientation")
							aori.Mode = Enum.OrientationAlignmentMode.OneAttachment
							aori.Attachment0 = att
							aori.CFrame = hrp.CFrame
							aori.MaxTorque = math.huge
							aori.Parent = hrp
							frozen[hum].apos = apos
							frozen[hum].aori = aori
						end)
					end
				else
					local f = frozen[hum]
					if f then
						pcall(function() hum.WalkSpeed = f.ws end)
						if f.apos then f.apos:Destroy() end
						if f.aori then f.aori:Destroy() end
						frozen[hum] = nil
					end
				end
			end
		end
	end
end
RunService.Heartbeat:Connect(function()
	if state.npcFreeze then freezeTick() end
end)
local function unfreezeAll()
	for hum, f in pairs(frozen) do
		pcall(function() if hum.Parent then hum.WalkSpeed = f.ws end end)
		if f.apos then f.apos:Destroy() end
		if f.aori then f.aori:Destroy() end
	end
	frozen = setmetatable({}, { __mode = "k" })
end

