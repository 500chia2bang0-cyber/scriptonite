			state.fly = v
			if v then startFly() else stopFly() end
		end)
		b.addSlider("Fly Speed", 20, 400, function() return state.flySpeed end,
			function(v) state.flySpeed = v end)
		b.addHeader("NOCLIP")
		b.addToggle("Noclip", function() return state.noclip end,
			function(v) state.noclip = v end)
		b.finish()
	end

	setActiveTab("AUTO")

	-- ===== BUBBLE (draggable, tap to reopen) =====
	local bubble = Instance.new("TextButton")
	bubble.Size = UDim2.new(0, 52, 0, 52)
	bubble.Position = UDim2.new(0, 16, 0, 60)
	bubble.BackgroundColor3 = Color3.fromRGB(255, 60, 120)
	bubble.Text = "oll"
	bubble.Font = Enum.Font.GothamBold
	bubble.TextSize = 14
	bubble.TextColor3 = Color3.fromRGB(255, 255, 255)
	bubble.BorderSizePixel = 0
	bubble.Visible = false
	bubble.Parent = gui
	local bc2 = Instance.new("UICorner")
	bc2.CornerRadius = UDim.new(1, 0)
	bc2.Parent = bubble

	minusBtn.MouseButton1Click:Connect(function()
		panel.Visible = false
		bubble.Position = panel.Position
		bubble.Visible = true
	end)

	local dragStart, startPos, moved
	bubble.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or
			input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragStart = input.Position
			startPos = bubble.Position
			moved = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragStart then return end
		if input.UserInputType == Enum.UserInputType.Touch or
			input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			if delta.Magnitude > 5 then moved = true end
			bubble.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if not dragStart then return end
		if input.UserInputType == Enum.UserInputType.Touch or
			input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not moved then
				bubble.Visible = false
				panel.Position = bubble.Position
				panel.Visible = true
			end
			dragStart = nil
		end
	end)
end

makeUI()

