	jc.Parent = joy

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 50, 0, 50)
	knob.Position = UDim2.new(0.5, -25, 0.5, -25)
	knob.BackgroundColor3 = Color3.fromRGB(255, 60, 120)
	knob.BorderSizePixel = 0
	knob.Parent = joy
	local knc = Instance.new("UICorner")
	knc.CornerRadius = UDim.new(1, 0)
	knc.Parent = knob

	local joyTouch
	joy.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			joyTouch = input
		end
	end)
	UserInputService.TouchMoved:Connect(function(input)
		if not joyTouch or joyTouch ~= input then return end
		local center = joy.AbsolutePosition + joy.AbsoluteSize / 2
		local delta = input.Position - center
		local maxR = joy.AbsoluteSize.X / 2
		if delta.Magnitude > maxR then delta = delta.Unit * maxR end
		knob.Position = UDim2.new(0.5, delta.X - 25, 0.5, delta.Y - 25)
		state.moveX = delta.X / maxR
		state.moveZ = delta.Y / maxR
	end)
	UserInputService.TouchEnded:Connect(function(input)
		if joyTouch and joyTouch ~= input then return end
		joyTouch = nil
		knob.Position = UDim2.new(0.5, -25, 0.5, -25)
		state.moveX = 0
		state.moveZ = 0
	end)

	RunService.Heartbeat:Connect(function()
		joy.Visible = state.fly
	end)
