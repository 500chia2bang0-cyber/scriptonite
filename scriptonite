			txt.TextXAlignment = Enum.TextXAlignment.Left
			txt.Parent = row

			local pill = Instance.new("Frame")
			pill.Size = UDim2.new(0, 48, 0, 26)
			pill.Position = UDim2.new(1, -48, 0.5, -13)
			pill.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
			pill.BorderSizePixel = 0
			pill.Parent = row
			local pcc = Instance.new("UICorner")
			pcc.CornerRadius = UDim.new(1, 0)
			pcc.Parent = pill

			local knob = Instance.new("Frame")
			knob.Size = UDim2.new(0, 20, 0, 20)
			knob.Position = UDim2.new(0, 3, 0.5, -10)
			knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			knob.BorderSizePixel = 0
			knob.Parent = pill
			local kc = Instance.new("UICorner")
			kc.CornerRadius = UDim.new(1, 0)
			kc.Parent = knob

			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 1, 0)
			btn.BackgroundTransparency = 1
			btn.Text = ""
			btn.Parent = row

			local function render()
				local on = getter()
				pill.BackgroundColor3 = on and Color3.fromRGB(255, 60, 120) or Color3.fromRGB(40, 40, 48)
				knob.Position = on and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
			end
			btn.MouseButton1Click:Connect(function()
				setter(not getter()); render()
			end)
			render()
			y += 42
		end
		local function addSlider(label, minV, maxV, getter, setter)
			local frame = Instance.new("Frame")
			frame.Size = UDim2.new(1, 0, 0, 50)
			frame.Position = UDim2.new(0, 0, 0, y)
			frame.BackgroundTransparency = 1
			frame.Parent = scroll

			local lab = Instance.new("TextLabel")
			lab.Size = UDim2.new(1, 0, 0, 16)
			lab.BackgroundTransparency = 1
			lab.Font = Enum.Font.Gotham
