local function pullItems()
	refreshItems()
	local root = getRoot()
	if not root then return end
	local rootPos = root.Position
	local pulled = 0
	for i = 1, #itemCache.items do
		local it = itemCache.items[i]
		if (it.part.Position - rootPos).Magnitude <= state.collectRange then
			local target = CFrame.new(rootPos + Vector3.new(
				math.random(-6, 6), 2, math.random(-6, 6)))
			if it.part:IsA("BasePart") then
				it.part.CFrame = target
			elseif it.part.Parent and it.part.Parent:IsA("Model") then
				pcall(function() it.part.Parent:PivotTo(target) end)
			end
			pulled += 1
		end
	end
	return pulled
end

--============ ESP ============
local espObjects = {}
local function destroyESPEntry(e)
	if e.hl then e.hl:Destroy() end
	if e.bb then e.bb:Destroy() end
end
local function clearESP()
	for _, e in pairs(espObjects) do destroyESPEntry(e) end
	espObjects = {}
end
local function makeESP(part, name, color, category)
	local adornee = (part.Parent and part.Parent:IsA("Model")) and part.Parent or part
	local hl = Instance.new("Highlight")
	hl.FillColor = color; hl.FillTransparency = 0.6
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = adornee; hl.Parent = part
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 160, 0, 28)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.AlwaysOnTop = true; bb.Parent = part
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.new(1, 0, 1, 0)
	tl.BackgroundTransparency = 1
	tl.Text = name
	tl.TextColor3 = Color3.fromRGB(255, 255, 255)
	tl.TextStrokeTransparency = 0
	tl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	tl.Font = Enum.Font.GothamBold; tl.TextSize = 14; tl.Parent = bb
	return { hl = hl, bb = bb, tl = tl, category = category, name = name }
end
local ESP_PRI = { custom = 50, chest = 40, item = 30, player = 20, npc = 10 }
local function syncESP()
	local targets = {}
	local function add(part, name, color, category, pri)
		local cur = targets[part]
		if cur and cur.pri >= pri then return end
		targets[part] = { name = name, color = color, category = category, pri = pri }
	end
	if state.esp.player then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				if hrp then add(hrp, plr.Name, Color3.fromRGB(255, 60, 60), "player", ESP_PRI.player) end
			end
		end
	end
	if state.esp.npc then
		refreshCache()
		for i = 1, #cache.models do
			local t = cache.models[i]
			if t.hum.Health > 0 and not Players:GetPlayerFromCharacter(t.model) then
				add(t.hrp, t.model.Name, Color3.fromRGB(255, 165, 0), "npc", ESP_PRI.npc)
			end
		end
	end
	if state.esp.chest then
		for _, inst in pairs(workspace:GetDescendants()) do
			if inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") then
				local parent = inst.Parent
				if parent then
					local pname = parent.Name or ""
					local full = pname .. " " .. ((inst.ObjectText) or "")
					if string.find(string.lower(full), "chest", 1, true) then
						local part = getPart(parent)
						if part then add(part, pname, Color3.fromRGB(255, 215, 0), "chest", ESP_PRI.chest) end
					end
				end
			end
		end
	end
	if state.esp.item then
		refreshItems()
		for i = 1, #itemCache.items do
			local it = itemCache.items[i]
			add(it.part, it.name, Color3.fromRGB(0, 255, 100), "item", ESP_PRI.item)
		end
	end
	if state.esp.custom and #state.esp.customKeywords > 0 then
		for _, inst in pairs(workspace:GetDescendants()) do
			local parent
			if inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") then parent = inst.Parent
			elseif inst:IsA("Model") then parent = inst end
			if parent and parent.Name and parent.Name ~= "" then
				if matchesKeyword(parent.Name, state.esp.customKeywords) then
					local part = getPart(parent)
					if part then add(part, parent.Name, Color3.fromRGB(180, 100, 255), "custom", ESP_PRI.custom) end
				end
			end
		end
	end
	for part, e in pairs(espObjects) do
		if not targets[part] then
			destroyESPEntry(e); espObjects[part] = nil
		elseif e.category ~= targets[part].category then
			destroyESPEntry(e); espObjects[part] = nil
		end
	end
	for part, info in pairs(targets) do
		if not espObjects[part] then
			espObjects[part] = makeESP(part, info.name, info.color, info.category)
		end
	end
end
