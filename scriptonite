local cache = { models = {}, nextRefresh = 0 }
local function refreshCache()
	local now = os.clock()
	if now < cache.nextRefresh then return end
	cache.nextRefresh = now + 0.25
	cache.models = {}
	local char = getChar()
	for _, obj in pairs(workspace:GetChildren()) do
		if obj:IsA("Model") and obj ~= char then
			local hum = obj:FindFirstChildOfClass("Humanoid")
			local hrp = obj:FindFirstChild("HumanoidRootPart")
			if hum and hrp then
				cache.models[#cache.models + 1] = { model = obj, hum = hum, hrp = hrp }
			end
		end
	end
end

--============ KILLBOX / KILLBRICK (hypolX core) ============
-- Invisible, non-colliding, touchable Part anchored to the player.
-- Touched handler applies math.huge damage + health 0 to any
-- non-player Humanoid it contacts. firetouchinterest drives
-- the contact per NPC. This is the actual hypolX mechanism.
local killbox = Instance.new("Part")
killbox.Name = "ollKillbox"
killbox.Size = Vector3.new(1, 1, 1)
killbox.Transparency = 1
killbox.CanCollide = false
killbox.CanTouch = true
killbox.CanQuery = false
killbox.Anchored = true
killbox.Massless = true
killbox.Parent = workspace

local function nukeHumanoid(hum)
	if not hum or hum.Health <= 0 then return end
	pcall(function() hum:TakeDamage(math.huge) end)
	pcall(function() if hum.Health > 0 then hum.Health = 0 end end)
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
	pcall(function() hum.PlatformStand = true end)
end

local function breakJoints(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") or d:IsA("JointInstance") or d:IsA("Weld") then
			pcall(function() d:Destroy() end)
		end
	end
end

killbox.Touched:Connect(function(hit)
	local model = hit and hit.Parent
	if not model then return end
	if Players:GetPlayerFromCharacter(model) then return end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then nukeHumanoid(hum) end
end)

local kaAccum = 0
local function npcAuraTick()
	local char = getChar()
	if not isAlive(char) then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local rootPos = root.Position
	-- follow the player
	killbox.CFrame = CFrame.new(rootPos)

	for i = 1, #cache.models do
		local t = cache.models[i]
		if t.hum.Health > 0 and t.hrp then
			local d = (t.hrp.Position - rootPos).Magnitude
			local isPlayer = Players:GetPlayerFromCharacter(t.model) ~= nil
			local inRange = (isPlayer and state.killAuraPlayer and d <= state.auraRangePlayer)
				or (not isPlayer and state.killAuraNPC and d <= state.auraRangeNPC)
			if inRange then
				-- 1) THE KILLBOX MOVE: fire touch both ways
				pcall(function()
					firetouchinterest(killbox, t.hrp, 0)
					firetouchinterest(killbox, t.hrp, 1)
				end)
				-- 2) DIRECT nuke (works on NPCs — they accept client health writes)
				if not isPlayer then
					nukeHumanoid(t.hum)
					pcall(function() breakJoints(t.model) end)
				else
					-- players: try damage remotes
					for _, r in ipairs(t.model:GetDescendants()) do
						if r:IsA("RemoteEvent") then
							local n = string.lower(r.Name)
							if n:find("damage") or n:find("hit") or n:find("take") then
								pcall(function() r:FireServer(9999, t.hrp) end)
								pcall(function() r:FireServer(9999) end)
							end
						end
					end
				end
			end
		end
	end
end
RunService.Heartbeat:Connect(function(dt)
	if not (state.killAuraPlayer or state.killAuraNPC) then
		killbox.CFrame = CFrame.new(0, -100, 0)
		return
	end
	kaAccum += dt
	if kaAccum < 0.05 then return end
	kaAccum = 0
	refreshCache()
	npcAuraTick()
end)

--============ DISGUISED AURA ============
local discAccum = 0
local savedReach = nil
local function disguisedTick()
	local char = getChar()
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		local bp = LocalPlayer:FindFirstChild("Backpack")
		if bp then
			for _, t in ipairs(bp:GetChildren()) do
				if t:IsA("Tool") then pcall(function() t.Parent = char end); break end
			end
		end
		tool = char:FindFirstChildOfClass("Tool")
	end
	if not tool then return end
	local blade = tool:FindFirstChild("Blade") or tool:FindFirstChild("Handle")
	if blade and blade:IsA("BasePart") then
		if not savedReach then savedReach = { size = blade.Size } end
		blade.Size = Vector3.new(state.disguiseRange, state.disguiseRange, state.disguiseRange)
		blade.CanTouch = true
	end
	pcall(function() tool:Activate() end)
	local root = getRoot()
	if not root then return end
	local rp = root.Position
	for i = 1, #cache.models do
		local t = cache.models[i]
		if t.hum.Health > 0 and t.hrp then
			if (t.hrp.Position - rp).Magnitude <= state.disguiseRange then
				pcall(function()
					firetouchinterest(root, t.hrp, 0)
					firetouchinterest(root, t.hrp, 1)
				end)
			end
		end
	end
end
local function restoreDisguise()
	if savedReach then
		local char = getChar()
		local tool = char and char:FindFirstChildOfClass("Tool")
		local blade = tool and (tool:FindFirstChild("Blade") or tool:FindFirstChild("Handle"))
		if blade and blade:IsA("BasePart") then blade.Size = savedReach.size end
		savedReach = nil
	end
end
RunService.Heartbeat:Connect(function(dt)
	if not state.disguisedAura then
		if savedReach then restoreDisguise() end
		return
	end
	discAccum += dt
	if discAccum < state.spamRate then return end
	discAccum = 0
	disguisedTick()
end)
