local frozen = setmetatable({}, { __mode = "k" })
local function freezeTick()
	if not state.npcFreeze then return end
	refreshCache()
	local char = getChar()
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local rp = root.Position
	for i = 1, #cache.models do
		local t = cache.models[i]
		if t.hum.Health > 0 and t.hrp and not Players:GetPlayerFromCharacter(t.model) then
			if (t.hrp.Position - rp).Magnitude <= state.freezeRange then
				if not frozen[t.hum] then
					frozen[t.hum] = { ws = t.hum.WalkSpeed }
					pcall(function() t.hum.WalkSpeed = 0 end)
					pcall(function()
						local att = t.hrp:FindFirstChildOfClass("Attachment")
						if not att then att = Instance.new("Attachment"); att.Parent = t.hrp end
						local apos = Instance.new("AlignPosition")
						apos.Mode = Enum.PositionAlignmentMode.OneAttachment
						apos.Attachment0 = att
						apos.Position = t.hrp.Position
						apos.MaxForce = math.huge
						apos.Parent = t.hrp
						local aori = Instance.new("AlignOrientation")
						aori.Mode = Enum.OrientationAlignmentMode.OneAttachment
						aori.Attachment0 = att
						aori.CFrame = t.hrp.CFrame
						aori.MaxTorque = math.huge
						aori.Parent = t.hrp
						frozen[t.hum].apos = apos
						frozen[t.hum].aori = aori
					end)
				end
			else
				local f = frozen[t.hum]
				if f then
					pcall(function() t.hum.WalkSpeed = f.ws end)
					if f.apos then f.apos:Destroy() end
					if f.aori then f.aori:Destroy() end
					frozen[t.hum] = nil
				end
			end
		end
	end
end
RunService.Heartbeat:Connect(function()
	if state.npcFreeze then freezeTick() end
end)
local function unfreezeAll()
	for hum, f in pairs(frozen) do
		pcall(function() if hum.Parent then hum.WalkSpeed = f.ws end end)
		if f.apos then f.apos:Destroy() end
		if f.aori then f.aori:Destroy() end
	end
	frozen = setmetatable({}, { __mode = "k" })
end

