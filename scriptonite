		b.addSlider("TP Delay (s)", 0.001, 2.0, function() return state.tpDelay end,
			function(v) state.tpDelay = v; saveSettings() end, true, 3)
		b.addSlider("Collect Delay (s)", 0.001, 2.0, function() return state.collectDelay end,
			function(v) state.collectDelay = v; saveSettings() end, true, 3)
		b.addHeader("AUTO OPEN")
		b.addToggle("Auto Open", function() return state.autoOpen end, function(v)
			state.autoOpen = v
			if v then task.spawn(autoOpenLoop) end
		end)
		b.addButton("[ Edit Open List ]", function()
			hideAllManagers(); openMgr.Visible = true
		end)
		b.addSlider("Open Delay (s)", 0.05, 2.0, function() return state.openDelay end,
			function(v) state.openDelay = v; saveSettings() end, true, 2)
		b.addHeader("AUTO DELETE (throttled)")
		b.addToggle("Auto Delete", function() return state.autoDelete end, function(v)
			state.autoDelete = v
			if v then task.spawn(autoDeleteLoop) end
		end)
		b.addButton("[ Edit Delete List ]", function()
			hideAllManagers(); deleteMgr.Visible = true
		end)
		b.addSlider("Delete Rate (/s)", 1, 100, function() return state.deleteRate end,
			function(v) state.deleteRate = v; saveSettings() end)
		b.addHeader("GRAB TOOLS")
		b.addToggle("Grab Tools", function() return state.grabTools end, function(v)
			state.grabTools = v
			if v then startGrabTools() else stopGrabTools() end
		end)
		b.finish()
	end

	-- FIGHT TAB
	do
		local b = buildersFor(tabs.FIGHT.scroll)
		b.addHeader("KILL AURA")
		b.addToggle("Player", function() return state.killAuraPlayer end,
			function(v) state.killAuraPlayer = v end)
		b.addSlider("Player Range", 5, 300, function() return state.auraRangePlayer end,
			function(v) state.auraRangePlayer = v end)
		b.addToggle("NPC", function() return state.killAuraNPC end,
			function(v) state.killAuraNPC = v end)
		b.addSlider("NPC Range", 5, 300, function() return state.auraRangeNPC end,
			function(v) state.auraRangeNPC = v end)
		b.addSlider("Scan Interval (s)", 0.05, 1.0, function() return state.auraInterval end,
			function(v) state.auraInterval = v; saveSettings() end, true, 2)
		b.addHeader("DISGUISED AURA")
		b.addToggle("Disguised Aura", function() return state.disguisedAura end,
			function(v) state.disguisedAura = v end)
		b.addSlider("Reach", 5, 60, function() return state.disguiseRange end,
			function(v) state.disguiseRange = v end)
		b.addSlider("Swing Rate (s)", 0.03, 0.5, function() return state.spamRate end,
			function(v) state.spamRate = v end, true, 2)
		b.addHeader("NPC FREEZE")
		b.addToggle("Freeze NPC", function() return state.npcFreeze end,
			function(v) state.npcFreeze = v; if not v then unfreezeAll() end end)
		b.addSlider("Freeze Range", 20, 1000, function() return state.freezeRange end,
			function(v) state.freezeRange = v end)
		b.finish()
	end

		-- MOVE TAB
	do
		local b = buildersFor(tabs.MOVE.scroll)
		b.addHeader("SPEED BOOST")
		b.addToggle("Speed Boost", function() return state.speedBoost end,
			function(v) state.speedBoost = v; if not v then
				local h = getChar() and getChar():FindFirstChildOfClass("Humanoid")
				if h then h.WalkSpeed = 16 end
			end end)
		b.addSlider("Walk Speed", 16, 500, function() return state.speedValue end,
			function(v) state.speedValue = v end)
		b.addHeader("JUMP BOOST")
		b.addToggle("Jump Boost", function() return state.jumpBoost end,
			function(v) state.jumpBoost = v; applyJump() end)
		b.addSlider("Jump Power", 50, 500, function() return state.jumpPower end,
			function(v) state.jumpPower = v end)
		b.addHeader("INVISIBLE")
		b.addToggle("Invisible", function() return state.invisible end,
			function(v) state.invisible = v; applyInvis() end)
		b.addHeader("FLY")
		b.addToggle("Fly", function() return state.fly end, function(v)
			state.fly = v; if v then startFly() else stopFly() end
		end)
		b.addSlider("Fly Speed", 20, 400, function() return state.flySpeed end,
			function(v) state.flySpeed = v end)
		b.addHeader("NOCLIP")
		b.addToggle("Noclip", function() return state.noclip end,
			function(v) state.noclip = v end)
		b.finish()
	end

	-- ESP TAB
	do
		local b = buildersFor(tabs.ESP.scroll)
		b.addHeader("ESP")
		b.addToggle("Player (đỏ)", function() return state.esp.player end,
			function(v) state.esp.player = v end)
		b.addToggle("NPC / Quái (cam)", function() return state.esp.npc end,
			function(v) state.esp.npc = v end)
		b.addToggle("Chest / Rương (vàng)", function() return state.esp.chest end,
			function(v) state.esp.chest = v end)
		b.addToggle("Item keyword (xanh lá)", function() return state.esp.item end,
			function(v) state.esp.item = v end)
		b.addHeader("ESP CUSTOM (tím)")
		b.addToggle("Custom", function() return state.esp.custom end,
			function(v) state.esp.custom = v end)
		b.addTextBox("hyper chest,boss,relic,...",
			function() return table.concat(state.esp.customKeywords, ",") end,
			function(text)
				local list = {}
				for kw in string.gmatch(text, "[^,%s]+") do table.insert(list, kw) end
				state.esp.customKeywords = list
			end)
		b.finish()
	end

	setActiveTab("AUTO")

	local bubble = Instance.new("TextButton")
	bubble.Size = UDim2.new(0, 48, 0, 48)
	bubble.Position = panel.Position
	bubble.BackgroundColor3 = Color3.fromRGB(255, 60, 120)
	bubble.Text = "oll"; bubble.Font = Enum.Font.GothamBold; bubble.TextSize = 13
	bubble.TextColor3 = Color3.fromRGB(255, 255, 255)
	bubble.BorderSizePixel = 0
	bubble.Visible = false; bubble.Parent = gui
	local bc2 = Instance.new("UICorner"); bc2.CornerRadius = UDim.new(1, 0); bc2.Parent = bubble

	minusBtn.MouseButton1Click:Connect(function()
		panel.Visible = false; bubble.Position = panel.Position; bubble.Visible = true
	end)
	local dragStart, startPos, moved
	bubble.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or
			input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragStart = input.Position; startPos = bubble.Position; moved = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragStart then return end
		if input.UserInputType == Enum.UserInputType.Touch or
			input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			if delta.Magnitude > 5 then moved = true end
			bubble.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if not dragStart then return end
		if input.UserInputType == Enum.UserInputType.Touch or
			input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not moved then
				bubble.Visible = false; panel.Position = bubble.Position; panel.Visible = true
			end
			dragStart = nil
		end
	end)
end

