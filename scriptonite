--============ NPC CACHE ============
local npcCache = {}
local function tryAddNPC(model)
	if not model or not model:IsA("Model") then return end
	if PLAYER_CHARS[model] then return end
	if Players:GetPlayerFromCharacter(model) then return end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if not model:FindFirstChild("HumanoidRootPart")
		and not model:FindFirstChild("UpperTorso")
		and not model:FindFirstChild("Torso") then return end
	npcCache[model] = true
end
local function scanNPCsOnce()
	npcCache = {}
	for _, d in ipairs(workspace:GetChildren()) do tryAddNPC(d) end
end
scanNPCsOnce()

