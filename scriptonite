local function applySpeed()
	local char = getChar()
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if state.speedBoost then pcall(function() hum.WalkSpeed = state.speedValue end) end
end
local function applyInvis()
	local char = getChar()
	if not char then return end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			pcall(function() p.LocalTransparencyModifier = state.invisible and 1 or 0 end)
		elseif p:IsA("Decal") or p:IsA("Texture") then
			pcall(function() p.Transparency = state.invisible and 1 or 0 end)
		end
	end
	for _, acc in ipairs(char:GetChildren()) do
		if acc:IsA("Accessory") then
			local h = acc:FindFirstChild("Handle")
			if h then h.Transparency = state.invisible and 1 or 0 end
		end
	end
end
RunService.Heartbeat:Connect(function()
	if state.jumpBoost then applyJump() end
	if state.speedBoost then applySpeed() end
end)
RunService.Stepped:Connect(function()
	if state.invisible then applyInvis() end
end)

--============ FLY ============
local flyConn, bv, bg, savedWalk
local function startFly()
	local char = getChar()
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	savedWalk = hum.WalkSpeed
	hum.WalkSpeed = 0
	bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e5,1e5,1e5)
	bv.Velocity = Vector3.zero; bv.Parent = hrp
	bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(1e5,1e5,1e5)
	bg.P = 9e4; bg.CFrame = hrp.CFrame; bg.Parent = hrp
	flyConn = RunService.Heartbeat:Connect(function()
		if not isAlive(char) then return end
		local cam = workspace.CurrentCamera
		local md = hum.MoveDirection
		if md.Magnitude > 0.01 then
			local lf = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
			local rf = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
			if lf.Magnitude > 0 then lf = lf.Unit end
			if rf.Magnitude > 0 then rf = rf.Unit end
			local dir = cam.CFrame.LookVector * md:Dot(lf) + cam.CFrame.RightVector * md:Dot(rf)
			bv.Velocity = dir.Magnitude > 0.001 and (dir.Unit * state.flySpeed) or Vector3.zero
		else
			bv.Velocity = Vector3.zero
		end
		bg.CFrame = cam.CFrame
	end)
end
local function stopFly()
	if flyConn then flyConn:Disconnect() end
	if bv then bv:Destroy() end
	if bg then bg:Destroy() end
	local char = getChar()
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and savedWalk then hum.WalkSpeed = savedWalk end
	end
end

