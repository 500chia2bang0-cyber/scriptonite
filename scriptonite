--============ ITEM CACHE ============
local itemCache = { items = {}, nextRefresh = 0 }
local function refreshItems()
	local now = os.clock()
	if now < itemCache.nextRefresh then return end
	itemCache.nextRefresh = now + 0.5
	itemCache.items = {}
	for _, inst in pairs(workspace:GetDescendants()) do
		if inst:IsA("ProximityPrompt") then
			local parent = inst.Parent
			if parent and matchesKeyword(((parent.Name or "") .. " " .. (inst.ObjectText or ""))) then
				local part = getPart(parent)
				if part then
					itemCache.items[#itemCache.items + 1] = {
						kind = "prompt", inst = inst, part = part,
						name = ((parent.Name or "") .. " " .. (inst.ObjectText or "")),
					}
				end
			end
		elseif inst:IsA("ClickDetector") then
			local parent = inst.Parent
			if parent and matchesKeyword(parent.Name) then
				local part = getPart(parent)
				if part then
					itemCache.items[#itemCache.items + 1] = {
						kind = "click", inst = inst, part = part, name = parent.Name,
					}
				end
			end
		elseif inst:IsA("BasePart") and matchesKeyword(inst.Name) then
			itemCache.items[#itemCache.items + 1] = {
				kind = "touch", inst = inst, part = inst, name = inst.Name,
			}
		end
	end
end

local function fireItem(item)
	if item.kind == "prompt" then
		pcall(function() item.inst:InputHoldBegin() end)
		pcall(function() item.inst:InputHoldEnd() end)
	elseif item.kind == "click" then
		pcall(function() fireclickdetector(item.inst) end)
	elseif item.kind == "touch" then
		local root = getRoot()
		if root then
			pcall(function()
				firetouchinterest(root, item.inst, 0)
				firetouchinterest(root, item.inst, 1)
			end)
		end
	end
end

local function itemPriority(name)
	local lower = string.lower(name)
	for i = 1, #state.keywords do
		if lower == string.lower(state.keywords[i]) then return 10000 end
	end
	local best = 0
	for i = 1, #state.keywords do
		local kw = string.lower(state.keywords[i])
		if string.sub(lower, 1, #kw) == kw then
			best = math.max(best, 500 + #lower)
		elseif string.find(lower, kw, 1, true) then
			best = math.max(best, #lower)
		end
	end
	return best
end

