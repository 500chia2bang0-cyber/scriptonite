-- olltaterfx | UNIVERSAL BENCH v4 — TABBED + TELE-COLLECT
-- kill aura(player/npc) + fly(joystick gốc) + noclip
-- auto-collect(teleport tức thì) | StarterPlayerScripts
--============================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

--============ STATE ============
local state = {
	killAuraPlayer = false,
	killAuraNPC = false,
	fly = false,
	noclip = false,
	autoCollect = false,
	auraRangePlayer = 20,
	auraRangeNPC = 20,
	flySpeed = 60,
	collectRange = 200,
	keywords = { "chest", "fragment", "orb", "heart", "coin", "gem", "crystal", "egg" },
}

local function getChar() return LocalPlayer.Character end
local function isAlive(c)
	return c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0
end

--============ KILL AURA ============
RunService.Heartbeat:Connect(function()
	if not (state.killAuraPlayer or state.killAuraNPC) then return end
	local char = getChar()
	if not isAlive(char) then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	for _, obj in pairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and obj ~= char then
			local hum = obj:FindFirstChildOfClass("Humanoid")
			local hrp = obj:FindFirstChild("HumanoidRootPart")
			if hum and hrp and hum.Health > 0 then
				local dist = (hrp.Position - root.Position).Magnitude
				local isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil
				if isPlayer and state.killAuraPlayer and dist <= state.auraRangePlayer then
					hum.Health = 0
				elseif (not isPlayer) and state.killAuraNPC and dist <= state.auraRangeNPC then
					hum.Health = 0
				end
			end
		end
	end
end)

--============ FLY (joystick gốc + xoay camera) ============
local flyConn, bv, bg, savedWalk = 16
local function startFly()
	local char = getChar()
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	savedWalk = hum.WalkSpeed
	hum.WalkSpeed = 0

	bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e5,1e5,1e5)
	bv.Velocity = Vector3.zero
	bv.Parent = hrp

	bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(1e5,1e5,1e5)
	bg.P = 9e4
	bg.CFrame = hrp.CFrame
	bg.Parent = hrp

	flyConn = RunService.Heartbeat:Connect(function()
		if not isAlive(char) then return end
		local cam = workspace.CurrentCamera
		local md = hum.MoveDirection
		if md.Magnitude > 0.01 then
			local lookFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
			local rightFlat = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
			if lookFlat.Magnitude > 0 then lookFlat = lookFlat.Unit end
			if rightFlat.Magnitude > 0 then rightFlat = rightFlat.Unit end
			local fwd = md:Dot(lookFlat)
			local rgt = md:Dot(rightFlat)
			local dir = cam.CFrame.LookVector * fwd + cam.CFrame.RightVector * rgt
			if dir.Magnitude > 0.001 then
				bv.Velocity = dir.Unit * state.flySpeed
			else
				bv.Velocity = Vector3.zero
			end
		else
			bv.Velocity = Vector3.zero
		end
		bg.CFrame = cam.CFrame
	end)
end

local function stopFly()
	if flyConn then flyConn:Disconnect() end
	if bv then bv:Destroy() end
	if bg then bg:Destroy() end
	local char = getChar()
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = savedWalk end
	end
end

--============ NOCLIP ============
RunService.Stepped:Connect(function()
	if not state.noclip then return end
	local char = getChar()
	if not char then return end
	for _, part in pairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			part.CanCollide = false
		end
	end
end)

--============ AUTO COLLECT (teleport + grab) ============
local function matchesKeyword(name)
	local lower = string.lower(name)
	for _, kw in ipairs(state.keywords) do
		if string.find(lower, string.lower(kw), 1, true) then return true end
	end
	return false
end

local function getPart(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

local collectAccum = 0
RunService.Heartbeat:Connect(function(dt)
	if not state.autoCollect then return end
	collectAccum += dt
	if collectAccum < 0.12 then return end
	collectAccum = 0

	local char = getChar()
	if not isAlive(char) then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	-- tìm target gần nhất trong range
	local best, bestDist = nil, math.huge
	local bestKind = nil

	for _, inst in pairs(workspace:GetDescendants()) do
		if inst:IsA("ProximityPrompt") and inst.Enabled then
			local parent = inst.Parent
			local name = ((parent and parent.Name) or "") .. " " .. (inst.ObjectText or "")
			if matchesKeyword(name) then
				local part = parent and getPart(parent)
				if part then
					local d = (part.Position - root.Position).Magnitude
					if d <= state.collectRange and d < bestDist then
						best, bestDist, bestKind = {inst = inst, part = part}, d, "prompt"
					end
				end
			end
		elseif inst:IsA("ClickDetector") then
			local parent = inst.Parent
			if parent and matchesKeyword(parent.Name) then
				local part = getPart(parent)
				if part then
					local d = (part.Position - root.Position).Magnitude
					if d <= state.collectRange and d < bestDist then
						best, bestDist, bestKind = {inst = inst, part = part}, d, "click"
					end
				end
			end
		elseif inst:IsA("BasePart") and matchesKeyword(inst.Name) then
			local d = (inst.Position - root.Position).Magnitude
			if d <= state.collectRange and d < bestDist then
				best, bestDist, bestKind = {inst = inst, part = inst}, d, "touch"
			end
		end
	end

	if not best then return end

	-- teleport tức thì tới vật thể
	if bestDist > 4 then
		root.CFrame = CFrame.new(best.part.Position + Vector3.new(0, 3, 0))
	end

	-- nhặt tức thì, bỏ qua hold
	if bestKind == "prompt" then
		pcall(function() best.inst:InputHoldBegin() end)
		pcall(function() best.inst:InputHoldEnd() end)
	elseif bestKind == "click" then
		pcall(function() fireclickdetector(best.inst) end)
	elseif bestKind == "touch" then
		pcall(function()
			firetouchinterest(root, best.inst, 0)
			firetouchinterest(root, best.inst, 1)
		end)
	end
end)

