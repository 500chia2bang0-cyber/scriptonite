--============ HELPERS ============
local function getChar() return LocalPlayer.Character end
local function getRoot()
	local c = getChar()
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function isAlive(c)
	return c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0
end
local function matchesKeyword(name, list)
	local lower = string.lower(name)
	list = list or state.keywords
	for i = 1, #list do
		if string.find(lower, string.lower(list[i]), 1, true) then return true end
	end
	return false
end
local function getPart(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

--============ SETTINGS PERSISTENCE ============
local SettingsFile = "olltaterfx_v10_settings.json"
local function hasFS()
	return type(writefile) == "function" and type(readfile) == "function"
		and type(isfile) == "function"
end
local function loadSettings()
	if not hasFS() then return end
	pcall(function()
		if isfile(SettingsFile) then
			local loaded = HttpService:JSONDecode(readfile(SettingsFile))
			if type(loaded) == "table" then
				for k, v in pairs(loaded) do
					if state[k] ~= nil then state[k] = v end
				end
			end
		end
	end)
end
local function saveSettings()
	if not hasFS() then return end
	pcall(function()
		writefile(SettingsFile, HttpService:JSONEncode({
			auraInterval = state.auraInterval,
			collectDelay = state.collectDelay, tpDelay = state.tpDelay,
			openDelay = state.openDelay, deleteRate = state.deleteRate,
			priorityList = state.priorityList,
			openList = state.openList,
			deleteList = state.deleteList,
			keywords = state.keywords,
		}))
	end)
end
loadSettings()

