	local function makeSlider(label, minV, maxV, getter, setter)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, 0, 0, 52)
		frame.Position = UDim2.new(0, 0, 0, y)
		frame.BackgroundTransparency = 1
		frame.Parent = scroll

		local lab = Instance.new("TextLabel")
		lab.Size = UDim2.new(1, 0, 0, 18)
		lab.BackgroundTransparency = 1
		lab.Font = Enum.Font.Gotham
		lab.Text = label .. ": " .. getter()
		lab.TextColor3 = Color3.fromRGB(200, 200, 200)
		lab.TextSize = 12
		lab.TextXAlignment = Enum.TextXAlignment.Left
		lab.Parent = frame

		local bg = Instance.new("Frame")
		bg.Size = UDim2.new(1, 0, 0, 10)
		bg.Position = UDim2.new(0, 0, 0, 30)
		bg.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
		bg.BorderSizePixel = 0
		bg.Parent = frame
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(1, 0)
		bc.Parent = bg

		local fill = Instance.new("Frame")
		fill.Size = UDim2.new((getter() - minV) / (maxV - minV), 0, 1, 0)
		fill.BackgroundColor3 = Color3.fromRGB(255, 60, 120)
		fill.BorderSizePixel = 0
		fill.Parent = bg
		local fc = Instance.new("UICorner")
		fc.CornerRadius = UDim.new(1, 0)
		fc.Parent = fill

		local hit = Instance.new("TextButton")
		hit.Size = UDim2.new(1, 0, 3, 0)
		hit.Position = UDim2.new(0, 0, -1, 0)
		hit.BackgroundTransparency = 1
		hit.Text = ""
		hit.Parent = bg

		local function setFromX(x)
			local rel = math.clamp(x / bg.AbsoluteSize.X, 0, 1)
			local v = math.floor(minV + rel * (maxV - minV))
			setter(v)
			fill.Size = UDim2.new(rel, 0, 1, 0)
			lab.Text = label .. ": " .. v
		end

		local dragging = false
		hit.MouseButton1Down:Connect(function() dragging = true end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or
				input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement or
				input.UserInputType == Enum.UserInputType.Touch then
				setFromX(input.Position.X - bg.AbsolutePosition.X)
			end
		end)
		y += 56
	end

