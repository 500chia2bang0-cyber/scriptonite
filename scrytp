local function makeSlider(label, min, max, default, cb)
    local f = Instance.new("Frame")
    f.Size             = UDim2.new(1, 0, 0, 52)
    f.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
    f.BorderSizePixel  = 0
    f.Parent           = Body
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel")
    lbl.Size             = UDim2.new(1, -16, 0, 20)
    lbl.Position         = UDim2.new(0, 8, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Font             = Enum.Font.GothamMedium
    lbl.TextSize         = 12
    lbl.TextColor3       = Color3.fromRGB(200, 200, 210)
    lbl.TextXAlignment   = Enum.TextXAlignment.Left
    lbl.Text             = label .. ": " .. default
    lbl.Parent           = f

    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(1, -16, 0, 6)
    bar.Position         = UDim2.new(0, 8, 0, 34)
    bar.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    bar.BorderSizePixel  = 0
    bar.Parent           = f
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new((default-min)/(max-min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(255, 60, 150)
    fill.BorderSizePixel  = 0
    fill.Parent           = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function setFromX(x)
        local abs = bar.AbsolutePosition.X
        local w   = bar.AbsoluteSize.X
        local p   = math.clamp((x - abs) / w, 0, 1)
        local v   = math.floor(min + (max - min) * p + 0.5)
        fill.Size = UDim2.new(p, 0, 1, 0)
        lbl.Text  = label .. ": " .. v
        cb(v)
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; setFromX(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement) then
            setFromX(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    return f
end

local function makeToggle(text, default, cb)
    local state = default or false
    local b = makeButton((state and "● " or "○ ") .. text)
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.Text = "  " .. (state and "● " or "○ ") .. text
    b.MouseButton1Click:Connect(function()
        state = not state
        b.Text = "  " .. (state and "● " or "○ ") .. text
        b.BackgroundColor3 = state and Color3.fromRGB(255,60,150)
                                 or Color3.fromRGB(35,35,42)
        cb(state)
    end)
    return b, function() return state end
end

-- ===================== SECTION: FLY =====================
local flying = false
local flySpeed = CFG.FlySpeed
local flyBV, flyBG, flyConn
local flyVel = Vector3.zero

local function stopFly()
    flying = false
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    local c = LP.Character
    if c then
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _,v in ipairs(hrp:GetChildren()) do
                if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
            end
        end
    end
end

local function startFly()
    if not isAlive(LP) then return end
    local c = LP.Character
    local hrp = c.HumanoidRootPart
    local hum = c:FindFirstChildOfClass("Humanoid")
    hum.PlatformStand = true
    flying = true
    flyVel = Vector3.zero

    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent   = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    flyBG.P          = 3e4
    flyBG.D          = 500
    flyBG.CFrame     = hrp.CFrame
    flyBG.Parent     = hrp

    flyConn = RunService.RenderStepped:Connect(function(dt)
        if not isAlive(LP) then stopFly(); return end
        local move = Vector3.zero
        -- joystick / touch move vector
        local mv = hum.MoveDirection
        if mv.Magnitude > 0 then
            move = (Cam.CFrame.LookVector * -mv.Z + Cam.CFrame.RightVector * mv.X)
            move = Vector3.new(move.X, 0, move.Z)
        end
        -- vertical via camera look
        local lookY = Cam.CFrame.LookVector.Y
        local target = (move.Unit * flySpeed) * (move.Magnitude > 0 and 1 or 0)
        target = target + Vector3.new(0, lookY * flySpeed, 0)

        -- hard stop when no input
        if hum.MoveDirection.Magnitude < 0.05 then
            target = Vector3.new(0, lookY * flySpeed * 0.9, 0)
            if math.abs(lookY) < 0.05 then target = Vector3.zero end
        end

        flyVel = flyVel:Lerp(target, math.clamp(dt * 12, 0, 1))
        flyBV.Velocity = flyVel
        flyBG.CFrame   = CFrame.new(hrp.Position) * (Cam.CFrame - Cam.CFrame.Position)
        hrp.CFrame     = CFrame.new(hrp.Position) * (Cam.CFrame - Cam.CFrame.Position)
    end)
end

