-- ===================== SECTION: ESP (12 Hz) =====================
local espCache = {}
local espOn = false

local function makeESP(plr)
    if plr == LP then return end
    local box = Drawing and Drawing.new("Square") or nil
    local name = Drawing and Drawing.new("Text")   or nil
    local dist = Drawing and Drawing.new("Text")   or nil
    local hlt  = Instance.new("Highlight")
    hlt.Name = "\0ofxESP"
    hlt.FillColor = Color3.new(1,1,1)
    hlt.FillTransparency = 0.55
    hlt.OutlineColor = Color3.new(1,1,1)
    hlt.OutlineTransparency = 0
    hlt.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    if plr.Character then hlt.Parent = plr.Character end

    if box then
        box.Color = Color3.new(1,1,1); box.Thickness = 1.2; box.Filled = false
    end
    if name then
        name.Color = Color3.new(1,1,1); name.Size = 14; name.Center = true
        name.Outline = true; name.OutlineColor = Color3.new(0,0,0)
    end
    if dist then
        dist.Color = Color3.fromRGB(255,200,220); dist.Size = 12; dist.Center = true
        dist.Outline = true; dist.OutlineColor = Color3.new(0,0,0)
    end

    espCache[plr] = {box=box, name=name, dist=dist, hl=hlt}
end

local function removeESP(plr)
    local d = espCache[plr]
    if not d then return end
    pcall(function() if d.box then d.box:Remove() end end)
    pcall(function() if d.name then d.name:Remove() end end)
    pcall(function() if d.dist then d.dist:Remove() end end)
    pcall(function() if d.hl then d.hl:Destroy() end end)
    espCache[plr] = nil
end

local function startESP()
    espOn = true
    for _,p in ipairs(Players:GetPlayers()) do if p ~= LP then makeESP(p) end end
    task.spawn(function()
        while espOn do
            local cam = workspace.CurrentCamera
            for plr, d in pairs(espCache) do
                local ok = pcall(function()
                    if plr.Character then
                        if d.hl and d.hl.Parent ~= plr.Character then
                            d.hl.Parent = plr.Character
                        end
                        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                        local head = plr.Character:FindFirstChild("Head")
                        if hrp and head and d.box then
                            local v, on = cam:WorldToViewportPoint(hrp.Position)
                            if on and v.Z > 0 then
                                local top = cam:WorldToViewportPoint(head.Position + Vector3.new(0,0.6,0))
                                local bot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0,2.5,0))
                                local h = math.abs(bot.Y - top.Y)
                                local w = h * 0.55
                                local myPos = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                                local distVal = myPos and (myPos.Position - hrp.Position).Magnitude or 0
                                if d.box then
                                    d.box.Size = Vector2.new(w, h)
                                    d.box.Position = Vector2.new(v.X - w/2, top.Y)
                                    d.box.Visible = true
                                end
                                if d.name then
                                    d.name.Text = plr.Name
                                    d.name.Position = Vector2.new(v.X, top.Y - 18)
                                    d.name.Visible = true
                                end
                                if d.dist then
                                    d.dist.Text = string.format("[%dm]", math.floor(distVal))
                                    d.dist.Position = Vector2.new(v.X, bot.Y + 4)
                                    d.dist.Visible = true
                                end
                            else
                                if d.box then d.box.Visible = false end
                                if d.name then d.name.Visible = false end
                                if d.dist then d.dist.Visible = false end
                            end
                        end
                    end
                end)
            end
            task.wait(CFG.ESP_Rate)
        end
    end)
end

local function stopESP()
    espOn = false
    for plr,_ in pairs(espCache) do removeESP(plr) end
end

makeToggle("ESP (12Hz)", false, function(s)
    if s then startESP() else stopESP() end
end)

