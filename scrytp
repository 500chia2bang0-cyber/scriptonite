-- teleport a small slapper under target's feet and lock them,
-- then spin violently -> classic fling
local flingState = {}
local function flingPlayer(target)
    if not isAlive(target) or not isAlive(LP) then return end
    local tChar = target.Character
    local tHRP  = tChar.HumanoidRootPart
    local tHum  = tChar:FindFirstChildOfClass("Humanoid")
    local myHRP = LP.Character.HumanoidRootPart

    if flingState[target] then return end
    flingState[target] = true

    -- lock target to my underside
    local anchor = Instance.new("Part")
    anchor.Name = "\0ofx"
    anchor.Size = Vector3.new(2,1,2)
    anchor.Transparency = 1
    anchor.CanCollide = false
    anchor.Anchored = true
    anchor.CFrame = myHRP.CFrame * CFrame.new(0,-4,0)
    anchor.Parent = workspace

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = anchor
    weld.Part1 = tHRP
    weld.Parent = anchor

    tHum.PlatformStand = true
    local spin = 0
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not anchor.Parent or not isAlive(target) then
            conn:Disconnect(); flingState[target] = nil
            if anchor then anchor:Destroy() end
            return
        end
        spin = spin + dt * 60
        anchor.CFrame = myHRP.CFrame * CFrame.new(0,-4,0)
                            * CFrame.Angles(0, math.rad(spin), math.rad(spin*0.7))
    end)

    -- auto-release after 4s
    task.delay(4, function()
        if conn then conn:Disconnect() end
        if anchor then anchor:Destroy() end
        flingState[target] = nil
    end)
end

