local function freezeChar(char, dur)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local oldWalk = hum.WalkSpeed
    local oldJump = hum.JumpPower
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    local bv = hrp:FindFirstChild("\0ofxFreeze")
    if not bv then
        bv = Instance.new("BodyPosition")
        bv.Name = "\0ofxFreeze"
        bv.MaxForce = Vector3.new(1e5,1e5,1e5)
        bv.Position = hrp.Position
        bv.Parent = hrp
    end
    task.delay(dur, function()
        if bv and bv.Parent then bv:Destroy() end
        if hum and hum.Parent then
            hum.WalkSpeed = oldWalk
            hum.JumpPower = oldJump
        end
    end)
end

