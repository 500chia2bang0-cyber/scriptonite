-- draggable bubble
local dragging, dragStart, startPos = false, nil, nil
Bubble.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch
    or i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        Bubble.Dragged = false
        dragStart = i.Position
        startPos = Bubble.Position
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.Touch
    or i.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = i.Position - dragStart
        if delta.Magnitude > 6 then Bubble.Dragged = true end
        Bubble.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch
    or i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        task.delay(0.15, function() Bubble.Dragged = nil end)
    end
end)

-- ===================== CLEANUP ON RESPAWN =====================
LP.CharacterAdded:Connect(function(c)
    task.wait(1)
    -- rebuild hidden watermark on new char
    pcall(function()
        local m = Instance.new("StringValue")
        m.Name = "\0ofx"; m.Value = WATERMARK; m.Parent = LP
    end)
    if invis then
        for _,p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.LocalTransparencyModifier = 1
                p.Transparency = 1
            end
        end
    end
    if flying then stopFly(); flyBtn.Text = "✈ Fly: OFF" end
end)

print("[ofx] loaded · " .. CFG.Watermark)
